# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
*.textClipping

# Backups de patches
*.bak.*

# Sentry Config File
.env.sentry-build-plugin

BYNX_MASTER_CONTEXT.md
BYNX_SEO_HUB_DEEP_DIVE.md
BYNX_SCAN_DEEP_DIVE.md

BYNX_MASTER_v7.md
BYNX_MASTER*.md
docs/features/

# Artes cheias das Paginas Lendarias vivem no Supabase Storage (bucket paginas-lendarias)
# No repo ficam so as versoes leves da landing (-lp 760px / -mini 320px)
public/paginas-lendarias/*.webp
!public/paginas-lendarias/*-lp.webp
!public/paginas-lendarias/*-mini.webp
